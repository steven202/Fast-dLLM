answer:  def rounded_avg(n, m):
    if n > m:
        return -1
    
    # Calculate the average of the integers from n to m
    avg = (n + m) / 2
    
    # Round the average to the nearest integer
    rounded_avg = round(avg)
    
    # Convert the rounded average to binary
    binary_rep = bin(rounded_avg)[2:]
    
    return binary_rep

# Example usage:
