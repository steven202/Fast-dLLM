    """
    if len(l) <= 1:
        return True
    
    for i in range(1, len(l)):
        if l[i] < l[i - 1]:
            return False
    
    return True

# Test cases
if __name__ == "__main__":
    import doctest
    doctest.testmod()
```

### Explanation:
