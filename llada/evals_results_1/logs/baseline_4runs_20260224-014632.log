answer:  def unique_digits(x):
    """Given a list of positive integers x, return a sorted list of all 
    elements that don't have any even digit.

    Note: Returned list should be sorted in increasing order.
    
    For example:
    >>> unique_digits([15, 33, 1422, 1])
    [1, 15, 33]
    >>> unique_digits([152, 323, 1422, 10])
    []
    """
    # Convert each number to a string and check if all digits are odd
    odd_digits = [num for num in x if all(num % 2 != 0 for num in str(num))]
    # Sort the list of odd digits
    odd_digits.sort()
    return odd_digits

