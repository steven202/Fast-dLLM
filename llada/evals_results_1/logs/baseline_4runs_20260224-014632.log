answer:  def histogram(test):
    counts = {}
    for letter in test:
        if letter not in counts:
            counts[letter] = 1
        else:
            counts[letter] += 1
    
    max_count = max(counts.values())
    max_count = max_count if max_count > 1 else 1
    
    result = {letter: count for letter, count in counts.items() if count == max_count}
    
    return result

