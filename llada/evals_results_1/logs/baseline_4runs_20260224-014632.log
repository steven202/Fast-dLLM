```python
def by_length(arr):
    # Step 1: Filter out integers between 1 and 9 inclusive
    filtered_arr = [x for x in arr if 1 <= x <= 9]
    
    # Step 2: Sort the filtered array
    sorted_arr = sorted(filtered_arr)
    
    # Step 3: Reverse the sorted array
    reversed_arr = sorted_arr[::-1]
    
    # Step 4: Replace each digit by its corresponding name
    digit_names = ["One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine"]
    result = [digit_names[digit] for digit in reversed_arr]
    
    return result

# Example usage:
