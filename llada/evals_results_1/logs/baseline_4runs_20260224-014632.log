def get_max_triples(n):
    # Generate the array a
    a = [i * i - i + 1 for i in range(n)]
    
    # Initialize the count of valid triples
    count = 0
    
    # Iterate through all possible triples (i, j, k)
    for i in range(n):
        for j in range(i + 1, n):
            for k in range(j + 1, n):
                if a[i] + a[j] + a[k] % 3 == 0:
                    count += 1
    
    return count

# Example usage:
