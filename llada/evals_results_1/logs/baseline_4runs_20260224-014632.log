def sorted_list_sum(lst):
    # Step 1: Filter out the strings with odd lengths
    filtered_list = [s for s in lst if len(s) % 2 == 0]
    
    # Step 2: Sort the list first by length, then alphabetically
    sorted_list = sorted(filtered_list, key=lambda s: (len(s), s))
    
    return sorted_list

# Test cases
