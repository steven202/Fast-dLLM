answer:  from typing import List

def parse_nested_parens(paren_string: str) -> List[int]:
    """
    This function takes a string containing multiple groups of nested parentheses separated by spaces.
    For each group, it returns the deepest level of nesting.

    For example, for the group '(()())', the deepest level of nesting is 2, and for '((()))', it is 3.

    >>> parse_nested_parens('(()()) ((())) () ((())()())')
    [2, 3, 1, 3]
    """
    groups = paren_string.split()
    results = []
    for group in groups:
        length = len(group)
        if length > 0:
            level = 0
            for i in range(length):
                if group[i] == '(':
                    level += 1
                elif group[i] == ')':
                    level -= 1
                    if level < 0:
                        level = 0
            results.append(level)
    return results

if __name__ == "__main__":
    import doct
    doct.testmod()
