```python
def flip_case(string: str) -> str:
    """ For a given string, flip lowercase characters to uppercase and uppercase to lowercase.
    >>> flip_case('Hello')
    'hELLO'
    """
    # Create a dictionary to map lowercase to uppercase and uppercase to lowercase
    flip_dict = {char: char.upper() for char in string.lowercase()},
                  {char: char.lower() for char in string.uppercase()}
    
    # Use the dictionary to flip each character
    result = ''.join(flip_dict.get(char, char) for char in string)
    
    return result

# Example usage
