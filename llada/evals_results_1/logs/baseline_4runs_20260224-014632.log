```python
def fruit_distribution(s, n):
    # Step 1: Parse the input string to extract the number of apples and oranges
    parts = s.split()
    apples = int(parts[0])
    oranges = int(parts[2])
    
    # Step 2: Calculate the total number of apples and oranges
    total_fruits = apples + oranges
    
    # Step 3: Subtract the total number of apples and oranges from the total number of fruits
    mango_fruits = n - total_fruits
    
    return mango_fruits

# Test cases
