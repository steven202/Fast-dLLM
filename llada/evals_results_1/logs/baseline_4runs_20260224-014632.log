answer:  def largest_smallest_integers(lst):
    if not lst:
        return (None, None)

    negative_integers = []
    positive_integers = []

    for num in lst:
        if num < 0:
            negative_integers.append(num)
        else:
            positive_integers.append(num)

    if not negative_integers:
        return (None, None)

    if not positive_integers:
        return (None, None)

    largest_negative = max(negative_integers)
    smallest_positive = min(positive_integers)

    return (largest_negative, smallest_positive)

