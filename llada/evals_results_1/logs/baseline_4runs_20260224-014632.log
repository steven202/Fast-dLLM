answer:  def file_name_check(file_name):
    if len(file_name) < 4:
        return 'No'
    
    # Check for more than three digits
    if any(c.isdigit() for c in file_name) > 3:
        return 'No'
    
    # Check for exactly one dot
    if file_name.count('.') != 1:
        return 'No'
    
    # Check the substring before the dot
    split_name = file_name.split('.')
    if len(split_name) != 2:
        return 'No'
    if not split_name[0].isalpha():
        return 'No'
    
    # Check the substring after the dot
    if split_name[1] not in ['txt', 'exe', 'dll']:
        return 'No'
    
    return 'Yes'

# Examples:
print(file_name_check("example.txt")) # => 'Yes'
print(file_name_check("1example.dll")) # => 'No'
print(file_name_check("example1.txt")) # => 'No'
print(file_name_check("123example.txt")) # => 'No'
