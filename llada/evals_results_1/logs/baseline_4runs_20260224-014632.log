def tri(n):
    if n <= 0:
        return []
    elif n == 1:
        return [3]
    elif n == 2:
        return [1 + 2 / 2]
    else:
        result = []
        for i in range(3, n + 1):
            value = result[-1] + result[-2] + result[-3]
            result.append(value)
        return result

