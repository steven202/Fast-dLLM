answer:  from typing import List


def parse_music(music_string: str) -> List[int]:
    """ Input is a string of musical notes.
    Output is a list of integers representing the number of beats for each note.

    'o' - whole note, 4 beats
    'o|' - half note, 2 beats
    '.|' - quarter note, 1 beat

    >>> parse_music('o o| .| o| o| .| .| .| .| o o')
    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]
    """
    beats = []
    for note in music_string:
        if note == 'o':
            beats.append(4)
        elif note == 'o|':
            beats.append(2)
        elif note == '.|':
            beats.append(1)
        else:
            raise ValueError(f"Unknown note: {note}")
    return beats


